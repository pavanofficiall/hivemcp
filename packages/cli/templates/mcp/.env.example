HIVE_APP_BASE_URL=http://localhost:3000
HIVE_MCP_PORT=3333
# Optional existing application credentials. Never commit .env.
# HIVE_APP_BEARER_TOKEN=
# HIVE_APP_COOKIE=
# Forward incoming Authorization / Cookie headers only when explicitly enabled:
HIVE_FORWARD_AUTH=false
# Optional shared bearer token protecting the local MCP endpoint:
# HIVE_MCP_TOKEN=
# HIVE_HTTP_TIMEOUT_MS=15000
# Remote access through a tunnel: comma-separated public Host values (e.g. abc.trycloudflare.com).
# Requires HIVE_MCP_TOKEN of at least 24 characters. Browser Origins must be listed separately.
# HIVE_ALLOWED_HOSTS=
# HIVE_ALLOWED_ORIGINS=
# Agent action log in .hive/logs/actions.jsonl: HIVE_LOG=off disables it, HIVE_LOG_ARGS=off omits arguments.
# HIVE_LOG_ARGS=on
